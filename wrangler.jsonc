{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shelfmade",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "observability": { "enabled": true },
  // Production values. Local development overrides these with .dev.vars.
  "vars": {
    "STORE_NAME": "Shelfmade",
    // Replace with your live address, e.g. https://shelfmade.<your-subdomain>.workers.dev or https://yourdomain.com
    "SITE_URL": "https://shelfmade.example.workers.dev",
    "ENVIRONMENT": "production",
    "CURRENCY": "usd",
    "STRIPE_AUTOMATIC_TAX": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shelfmade-db",
      "database_id": "a2ec0086-9d35-4693-92bf-9c1c7a3a8a23",
      "migrations_dir": "migrations"
    }
  ],
  // Product files and cover images (Workers KV: free tier, no payment method needed).
  "kv_namespaces": [
    { "binding": "FILES", "id": "b5ab4359fab046cfb146a73a5821293a" }
  ]
}
