{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shelfmade",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "observability": { "enabled": true },
  // Production values. Local development overrides these with .dev.vars.
  "vars": {
    "STORE_NAME": "Shelfmade",
    // Replace with your live address, e.g. https://shelfmade.<your-subdomain>.workers.dev or https://yourdomain.com
    "SITE_URL": "https://shelfmade.example.workers.dev",
    "ENVIRONMENT": "production",
    "CURRENCY": "usd",
    "STRIPE_AUTOMATIC_TAX": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shelfmade-db",
      // Replace with the id printed by `npx wrangler d1 create shelfmade-db`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "shelfmade-files" }
  ]
}
