---
import Admin from "../../../layouts/Admin.astro";
import { getEnv } from "../../../lib/env";
import {
  addFile, archiveFile, deleteProduct, getFile, getProductById, listFiles, productHasOrders, removeFile, saveProduct,
} from "../../../lib/db/products";
import { MAX_COVER_BYTES, MAX_UPLOAD_BYTES, parseProductForm, safeFileName } from "../../../lib/admin/product-form";
import { formatBytes, mediaUrl } from "../../../lib/urls";
import type { Product } from "../../../lib/types";

const env = getEnv();
const db = env.DB;
const id = Astro.params.id!;
const isNew = id === "new";
let product: Product | null = isNew ? null : await getProductById(db, id);
if (!isNew && (!product || product.deletedAt)) return Astro.redirect("/admin/products");

let errors: Record<string, string> = {};
let values: Record<string, string> = {};
let flash = Astro.url.searchParams.get("msg") ?? "";
let fileError = "";

const isFile = (v: FormDataEntryValue | null): v is File => typeof v === "object" && v !== null && "arrayBuffer" in v && (v as File).size > 0;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "save");

  if (action === "save") {
    const parsed = parseProductForm(form);
    if (!parsed.ok) errors = { ...parsed.errors };
    const cover = form.get("cover");
    if (isFile(cover)) {
      if (!cover.type.startsWith("image/")) errors.cover = "Cover must be an image (JPG, PNG or WebP).";
      else if (cover.size > MAX_COVER_BYTES) errors.cover = "Cover image must be 5 MB or smaller.";
    }
    if (parsed.ok && Object.keys(errors).length === 0) {
      const productId = product?.id ?? crypto.randomUUID();
      let coverKey = product?.coverKey ?? null;
      if (isFile(cover)) {
        const newKey = `covers/${productId}/${crypto.randomUUID().slice(0, 8)}-${safeFileName(cover.name)}`;
        await env.FILES.put(newKey, cover.stream(), { httpMetadata: { contentType: cover.type } });
        if (coverKey) await env.FILES.delete(coverKey);
        coverKey = newKey;
      } else if (form.get("removeCover") === "on" && coverKey) {
        await env.FILES.delete(coverKey);
        coverKey = null;
      }
      const saved = await saveProduct(db, { ...parsed.value, id: product?.id, newId: productId, coverKey }, new Date());
      return Astro.redirect(`/admin/products/${saved.id}?msg=saved`);
    }
    values = Object.fromEntries([...form.entries()].filter(([, v]) => typeof v === "string")) as Record<string, string>;
  }

  if (action === "delete" && product) {
    const r = await deleteProduct(db, product.id, new Date());
    if (r === "deleted") {
      if (product.coverKey) await env.FILES.delete(product.coverKey);
      // Files rows were removed; objects under products/<id>/ are cleaned up below.
      const listed = await env.FILES.list({ prefix: `products/${product.id}/` });
      if (listed.objects.length) await env.FILES.delete(listed.objects.map((o) => o.key));
    }
    return Astro.redirect(`/admin/products?msg=${r}`);
  }

  if (action === "upload" && product) {
    const file = form.get("file");
    if (!isFile(file)) fileError = "Choose a file to upload.";
    else if (file.size > MAX_UPLOAD_BYTES) fileError = "Files over 100 MB must be uploaded with Wrangler (see README), then registered below.";
    else {
      const name = safeFileName(file.name);
      const key = `products/${product.id}/${crypto.randomUUID().slice(0, 8)}-${name}`;
      await env.FILES.put(key, file.stream(), { httpMetadata: { contentType: file.type || "application/octet-stream" } });
      await addFile(db, { productId: product.id, r2Key: key, displayName: String(form.get("displayName") ?? "").trim() || file.name, sizeBytes: file.size, contentType: file.type || "application/octet-stream" }, new Date());
      return Astro.redirect(`/admin/products/${product.id}?msg=file-added#files`);
    }
  }

  if (action === "register" && product) {
    const key = String(form.get("r2Key") ?? "").trim();
    const head = key.startsWith(`products/${product.id}/`) ? await env.FILES.head(key) : null;
    if (!head) fileError = `No object found. Upload it to products/${product.id}/<name> first.`;
    else {
      await addFile(db, { productId: product.id, r2Key: key, displayName: String(form.get("displayName") ?? "").trim() || key.split("/").pop()!, sizeBytes: head.size, contentType: head.httpMetadata?.contentType || "application/octet-stream" }, new Date());
      return Astro.redirect(`/admin/products/${product.id}?msg=file-added#files`);
    }
  }

  if (action === "remove-file" && product) {
    const file = await getFile(db, String(form.get("fileId") ?? ""));
    if (file && file.productId === product.id) {
      if (await productHasOrders(db, product.id)) {
        await archiveFile(db, file.id, new Date());
        return Astro.redirect(`/admin/products/${product.id}?msg=file-archived#files`);
      }
      await removeFile(db, file.id);
      await env.FILES.delete(file.r2Key);
    }
    return Astro.redirect(`/admin/products/${product.id}?msg=file-removed#files`);
  }
}

const files = product ? await listFiles(db, product.id) : [];
const v = (k: string, fallback: string | number | null | undefined) => values[k] ?? (fallback == null ? "" : String(fallback));
const money = (c: number | null | undefined) => (c == null ? "" : (c / 100).toFixed(2));
const flashes: Record<string, string> = {
  saved: "Product saved.",
  "file-added": "File added.",
  "file-removed": "File removed.",
  "file-archived": "File hidden from the product page. Existing buyers can still download it.",
};
const err = (k: string) => errors[k];
---
<Admin title={isNew ? "New product" : product!.title}>
  <p><a href="/admin/products">← Products</a></p>
  <div class="row between">
    <h1>{isNew ? "New product" : "Edit product"}</h1>
    {product?.published && <a class="btn btn-secondary" href={`/p/${product.slug}`} target="_blank" rel="noopener">View on store ↗</a>}
  </div>
  {flash && flashes[flash] && <div class="notice notice-success" role="status"><p>{flashes[flash]}</p></div>}
  {Object.keys(errors).length > 0 && <div class="notice notice-danger" role="alert"><p>Please fix the highlighted fields.</p></div>}

  <form method="post" enctype="multipart/form-data" class="panel">
    <input type="hidden" name="action" value="save" />
    <div class="form-grid">
      <div class="field full">
        <label for="title">Title</label>
        <input id="title" name="title" class="input" required maxlength="200" value={v("title", product?.title)} aria-invalid={err("title") ? "true" : undefined} aria-describedby={err("title") ? "title-err" : undefined} />
        {err("title") && <p id="title-err" class="error">{err("title")}</p>}
      </div>
      <div class="field">
        <label for="price">Price (USD)</label>
        <input id="price" name="price" class="input" inputmode="decimal" required placeholder="19.00" value={v("price", money(product?.priceCents))} aria-invalid={err("price") ? "true" : undefined} aria-describedby="price-help" />
        {err("price") ? <p id="price-help" class="error">{err("price")}</p> : <p id="price-help" class="help">Minimum $0.50.</p>}
      </div>
      <div class="field">
        <label for="compareAt">Compare-at price (optional)</label>
        <input id="compareAt" name="compareAt" class="input" inputmode="decimal" placeholder="29.00" value={v("compareAt", money(product?.compareAtCents))} aria-describedby="compare-help" />
        {err("compareAt") ? <p id="compare-help" class="error">{err("compareAt")}</p> : <p id="compare-help" class="help">Shown struck through to indicate a sale.</p>}
      </div>
      <div class="field">
        <label for="category">Category</label>
        <input id="category" name="category" class="input" maxlength="60" placeholder="Templates" value={v("category", product?.category)} />
      </div>
      <div class="field">
        <label for="slug">URL slug</label>
        <input id="slug" name="slug" class="input" maxlength="80" placeholder="auto from title" value={v("slug", product?.slug)} aria-describedby="slug-help" />
        <p id="slug-help" class="help">The product address: /p/<em>slug</em></p>
      </div>
      <div class="field full">
        <label for="shortDesc">Short description</label>
        <input id="shortDesc" name="shortDesc" class="input" maxlength="300" value={v("shortDesc", product?.shortDesc)} aria-describedby="sd-help" />
        {err("shortDesc") ? <p id="sd-help" class="error">{err("shortDesc")}</p> : <p id="sd-help" class="help">One or two sentences, shown on cards and under the title.</p>}
      </div>
      <div class="field full">
        <label for="longDescMd">Full description (Markdown)</label>
        <textarea id="longDescMd" name="longDescMd" class="textarea" rows="12" aria-describedby="ld-help">{v("longDescMd", product?.longDescMd)}</textarea>
        <p id="ld-help" class="help">Use # for headings, - for bullet lists, **bold**, and [links](https://example.com). HTML is ignored.</p>
      </div>
      <div class="field">
        <label for="cover">Cover image</label>
        {product?.coverKey && <img src={mediaUrl(product.coverKey)} alt="Current cover" style="max-width:240px;border-radius:8px;border:1px solid var(--color-border)" />}
        <input id="cover" name="cover" type="file" accept="image/png,image/jpeg,image/webp,image/gif" aria-describedby="cover-help" />
        {err("cover") ? <p id="cover-help" class="error">{err("cover")}</p> : <p id="cover-help" class="help">4:3 ratio works best (e.g. 1600×1200). Up to 5 MB.</p>}
        {product?.coverKey && <label class="checkbox"><input type="checkbox" name="removeCover" /> Remove current cover</label>}
      </div>
      <div class="field">
        <label for="sort">Sort order</label>
        <input id="sort" name="sort" class="input" type="number" value={v("sort", product?.sort ?? 0)} aria-describedby="sort-help" />
        <p id="sort-help" class="help">Lower numbers appear first in "Featured".</p>
        <label class="checkbox"><input type="checkbox" name="published" checked={values.title !== undefined ? values.published === "on" : (product?.published ?? false)} /> Published (visible in the store)</label>
      </div>
    </div>
    <button class="btn btn-primary" type="submit">{isNew ? "Create product" : "Save changes"}</button>
  </form>

  {product && (
    <section id="files" style="margin-top:var(--space-7)">
      <h2>Files buyers receive</h2>
      {fileError && <div class="notice notice-danger" role="alert"><p>{fileError}</p></div>}
      {files.length === 0 ? <p class="muted">No files yet. Buyers will see "Files are being prepared" until you add one.</p> : (
        <div class="table-wrap"><table class="table">
          <thead><tr><th>Name</th><th>Type</th><th class="num">Size</th><th></th></tr></thead>
          <tbody>
            {files.map((f) => (
              <tr>
                <td>{f.displayName}</td>
                <td class="muted">{f.contentType}</td>
                <td class="num">{formatBytes(f.sizeBytes)}</td>
                <td class="num">
                  <form method="post" onsubmit="return confirm('Remove this file from the product?')">
                    <input type="hidden" name="action" value="remove-file" /><input type="hidden" name="fileId" value={f.id} />
                    <button class="btn btn-ghost" type="submit">Remove</button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table></div>
      )}
      <form method="post" enctype="multipart/form-data" class="panel" style="margin-top:var(--space-4)">
        <input type="hidden" name="action" value="upload" />
        <div class="form-grid">
          <div class="field"><label for="file">Upload a file</label><input id="file" name="file" type="file" required aria-describedby="file-help" /><p id="file-help" class="help">PDF, ZIP, etc. Up to 100 MB.</p></div>
          <div class="field"><label for="displayName">Display name (optional)</label><input id="displayName" name="displayName" class="input" placeholder="Defaults to the file name" /></div>
        </div>
        <button class="btn btn-secondary" type="submit">Upload file</button>
      </form>
      <details style="margin-top:var(--space-4)">
        <summary class="small">Register a large file already uploaded to R2</summary>
        <form method="post" class="panel" style="margin-top:var(--space-3)">
          <input type="hidden" name="action" value="register" />
          <div class="form-grid">
            <div class="field"><label for="r2Key">R2 key</label><input id="r2Key" name="r2Key" class="input" placeholder={`products/${product.id}/my-course.zip`} /></div>
            <div class="field"><label for="displayName2">Display name</label><input id="displayName2" name="displayName" class="input" /></div>
          </div>
          <button class="btn btn-secondary" type="submit">Register file</button>
        </form>
      </details>
    </section>

    <section style="margin-top:var(--space-7)">
      <h2>Danger zone</h2>
      <form method="post" onsubmit="return confirm('Delete this product? If anyone has bought it, it will be hidden from the store but buyers keep access.')">
        <input type="hidden" name="action" value="delete" />
        <button class="btn btn-danger" type="submit">Delete product</button>
      </form>
    </section>
  )}
</Admin>
