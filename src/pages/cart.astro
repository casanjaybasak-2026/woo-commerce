---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---
<Base title="Cart" noindex>
  <div class="container container-narrow">
    <div class="page-head"><h1>Your cart</h1></div>
    <div data-cart-root>
      <p class="muted" data-loading>Loading your cart…</p>
      <div data-empty hidden>
        <div class="empty">
          <h2>Your cart is empty</h2>
          <p class="muted">Find something useful in the shop.</p>
          <a class="btn btn-primary" href="/shop">Browse the shop</a>
        </div>
      </div>
      <div data-filled hidden>
        <p class="notice notice-warning" data-removed hidden role="status">Some items are no longer available and were removed.</p>
        <ul class="lines" data-lines></ul>
        <div class="summary card">
          <div class="row between"><span>Subtotal</span><strong data-subtotal></strong></div>
          <p class="muted small">Discount codes and any taxes are applied at checkout.</p>
          <button class="btn btn-primary btn-lg btn-block" type="button" data-checkout><Icon name="lock" size={18} /> Checkout securely</button>
          <p class="error" data-error hidden role="alert"></p>
          <p class="muted small center">Payments processed by Stripe. Your files are delivered instantly.</p>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  import { getCart, removeFromCart, setCart } from "../scripts/cart";

  type Line = { productId: string; title: string; slug: string; priceCents: number };
  const fmt = new Intl.NumberFormat("en-US", { style: "currency", currency: "USD" });
  const root = document.querySelector<HTMLElement>("[data-cart-root]")!;
  const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;

  async function render() {
    const ids = getCart();
    $("[data-loading]").hidden = true;
    if (ids.length === 0) {
      $("[data-empty]").hidden = false;
      $("[data-filled]").hidden = true;
      return;
    }
    const res = await fetch("/api/cart-preview", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ ids }) });
    const data: { lines: Line[]; subtotalCents: number; missing: string[] } = await res.json();
    if (data.missing.length) {
      setCart(ids.filter((id) => !data.missing.includes(id)));
      $("[data-removed]").hidden = false;
    }
    if (data.lines.length === 0) {
      $("[data-empty]").hidden = false;
      $("[data-filled]").hidden = true;
      return;
    }
    $("[data-empty]").hidden = true;
    $("[data-filled]").hidden = false;
    const ul = $("[data-lines]");
    ul.replaceChildren(
      ...data.lines.map((l) => {
        const li = document.createElement("li");
        li.className = "line";
        const a = document.createElement("a");
        a.href = `/p/${encodeURIComponent(l.slug)}`;
        a.textContent = l.title;
        const price = document.createElement("span");
        price.className = "line-price";
        price.textContent = fmt.format(l.priceCents / 100);
        const rm = document.createElement("button");
        rm.type = "button";
        rm.className = "btn btn-ghost remove";
        rm.textContent = "Remove";
        rm.setAttribute("aria-label", `Remove ${l.title}`);
        rm.addEventListener("click", () => {
          removeFromCart(l.productId);
          render();
        });
        li.append(a, price, rm);
        return li;
      }),
    );
    $("[data-subtotal]").textContent = fmt.format(data.subtotalCents / 100);
  }

  $<HTMLButtonElement>("[data-checkout]").addEventListener("click", async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const err = $("[data-error]");
    btn.setAttribute("aria-busy", "true");
    btn.disabled = true;
    err.hidden = true;
    try {
      const res = await fetch("/api/checkout", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ ids: getCart() }) });
      const data = await res.json();
      if (!res.ok || !data.url) throw new Error(data.message || "Checkout is unavailable right now. Please try again.");
      location.href = data.url;
    } catch (ex) {
      err.textContent = (ex as Error).message;
      err.hidden = false;
      btn.removeAttribute("aria-busy");
      btn.disabled = false;
    }
  });

  render().catch(() => {
    $("[data-loading]").textContent = "Couldn't load your cart. Please refresh the page.";
    $("[data-loading]").hidden = false;
  });
</script>

<style>
  .lines { list-style: none; padding: 0; margin: 0 0 var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius); }
  .lines :global(.line) { display: grid; grid-template-columns: 1fr auto auto; gap: var(--space-3); align-items: center; padding: var(--space-3) var(--space-4); }
  .lines :global(.line + .line) { border-top: 1px solid var(--color-border); }
  .lines :global(.line a) { color: var(--color-text); font-weight: 600; text-decoration: none; }
  .lines :global(.line-price) { font-weight: 700; font-variant-numeric: tabular-nums; }
  .summary { padding: var(--space-5); display: grid; gap: var(--space-3); }
  .summary p { margin: 0; }
  .center { text-align: center; }
  .empty { text-align: center; padding: var(--space-8) var(--space-4); border: 1px dashed var(--color-border-strong); border-radius: var(--radius-lg); }
</style>
