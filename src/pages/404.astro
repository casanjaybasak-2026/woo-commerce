---
import Base from "../layouts/Base.astro";
Astro.response.status = 404;
---
<Base title="Page not found" noindex>
  <div class="container container-narrow nf">
    <p class="eyebrow">Error 404</p>
    <h1>We couldn't find that page</h1>
    <p class="muted">It may have moved, or the product is no longer available.</p>
    <div class="row"><a class="btn btn-primary" href="/shop">Browse the shop</a><a class="btn btn-secondary" href="/">Home</a></div>
  </div>
</Base>
<style>.nf { padding-block: var(--space-9); text-align: center; } .nf .row { justify-content: center; }</style>
