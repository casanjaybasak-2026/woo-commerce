---
import type { Product } from "../lib/types";
import Cover from "./Cover.astro";
import Price from "./Price.astro";
interface Props { product: Product }
const { product: p } = Astro.props;
---
<a href={`/p/${p.slug}`} class="product-card card">
  <Cover coverKey={p.coverKey} title={p.title} />
  <div class="body">
    {p.category && <span class="eyebrow">{p.category}</span>}
    <h3 class="title">{p.title}</h3>
    {p.shortDesc && <p class="desc muted small">{p.shortDesc}</p>}
    <Price cents={p.priceCents} compareAtCents={p.compareAtCents} />
  </div>
</a>
<style>
  .product-card { display: flex; flex-direction: column; overflow: hidden; color: var(--color-text); text-decoration: none; transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease); }
  .product-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); color: var(--color-text); }
  .body { padding: var(--space-4) var(--space-5) var(--space-5); display: grid; gap: var(--space-2); flex: 1; align-content: start; }
  .title { font-size: var(--text-lg); font-weight: 600; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .desc { margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (prefers-reduced-motion: reduce) { .product-card:hover { transform: none; } }
</style>
