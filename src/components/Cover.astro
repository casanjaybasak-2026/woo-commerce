---
import { mediaUrl } from "../lib/urls";
interface Props { coverKey: string | null; title: string; eager?: boolean; class?: string }
const { coverKey, title, eager = false, class: cls } = Astro.props;
const initials = title.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]!.toUpperCase()).join("");
---
<div class:list={["cover", cls]}>
  {coverKey
    ? <img src={mediaUrl(coverKey)} alt={title} loading={eager ? "eager" : "lazy"} decoding="async" width="800" height="600" />
    : <div class="cover-fallback" aria-hidden="true"><span>{initials}</span></div>}
</div>
<style>
  .cover { aspect-ratio: 4 / 3; overflow: hidden; background: var(--color-surface-2); }
  .cover img { width: 100%; height: 100%; object-fit: cover; }
  .cover-fallback { width: 100%; height: 100%; display: grid; place-items: center; background: linear-gradient(135deg, var(--color-accent-soft), var(--color-surface-2)); }
  .cover-fallback span { font-size: clamp(2rem, 6vw, 3rem); font-weight: 700; color: var(--color-accent); opacity: .75; }
</style>
