# Reference list of every setting Shelfmade uses.
#  - Local development: copy .dev.vars.example to .dev.vars (Wrangler reads .dev.vars, not .env).
#  - Production: plain values live in wrangler.jsonc "vars"; secrets are set with
#      npx wrangler secret put <NAME>
#  - GitHub Actions: only CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID (repo secrets).

# --- wrangler.jsonc vars (not secret) ---
STORE_NAME=Shelfmade
SITE_URL=https://shelfmade.<your-subdomain>.workers.dev
ENVIRONMENT=production
CURRENCY=usd
STRIPE_AUTOMATIC_TAX=false

# --- Worker secrets (wrangler secret put) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
RESEND_API_KEY=re_...
EMAIL_FROM=Shelfmade <orders@yourdomain.com>
ADMIN_EMAILS=you@yourdomain.com
CF_ACCESS_TEAM_DOMAIN=<your-team>.cloudflareaccess.com
CF_ACCESS_AUD=<application audience tag>

# --- GitHub repository secrets ---
CLOUDFLARE_API_TOKEN=...
CLOUDFLARE_ACCOUNT_ID=...

# Local development only (never in production):
# DEV_ADMIN_BYPASS=true
